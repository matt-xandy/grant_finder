# Core settings
DATABASE_PATH=grantboard.db
ADMIN_TOKEN=change-me
RUN_TIMEZONE=America/New_York
RUN_HOUR=9
RUN_MINUTE=0

# Google Sheets
SPREADSHEET_ID=
SHEET_TAB=Sheet1
SHEET_URL=
GOOGLE_SERVICE_ACCOUNT_FILE=/absolute/path/to/service-account.json

# Email
EMAIL_ENABLED=false
EMAIL_TO=
EMAIL_FROM=

# SMTP fallback
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Gmail API (optional)
GMAIL_CREDENTIALS_FILE=
GMAIL_TOKEN_FILE=

# Requests
REQUEST_TIMEOUT=20
REQUEST_DELAY_SECONDS=1.5
REQUEST_MAX_RETRIES=3
REQUEST_BACKOFF_FACTOR=1.5
USER_AGENT=GrantTriageBoard/1.0 (+https://example.org; contact@example.org)

# Run limits
MAX_CANDIDATES_PER_SOURCE=20
MAX_APPEND_PER_RUN=10
